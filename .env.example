# Configuração exclusiva do backend. Nunca usar prefixo VITE_ para segredos.
PORT=3001
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Opcional: domínio público da aplicação para identificação no OpenRouter.
OPENROUTER_SITE_URL=
# Em produção, informe origens HTTPS separadas por vírgula.
NEXTCOM_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
